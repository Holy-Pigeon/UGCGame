*.log
*.tmp
*.suo
*.PackageVersionCounter
*.xcodeproj/*
*.xcworkspace/*
!*.xcworkspace/contents.xcworkspacedata
!*.xcworkspace/xcshareddata/
!*.xcworkspace/xcshareddata/**

# User-specific project files
*.opensdf
*.sdf
*.user
*.userprefs
